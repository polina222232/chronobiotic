           \setcounter{subsection}{0}
           \setcounter{table}{0}
           \addcontentsline{toc}{section}{{\bf\theruscontauth}~{\it\therusconttit}}
           \addcontentsline{lof}{section}{{\bf\theengcontauth}~{\it\theengconttit}}
           \vbox to0pt{\dimen0=\textheight
                       \advance\dimen0 5mm%\baselineskip
                       \vbox to\dimen0{\vfill\hbox to0pt{\hskip-\parindent%
                       \footnotesize\copyright\ \theruscontauth, \theyear.\hss}}\vss}

            \moveright27mm\vbox{\itshape
            {\small\noindentВестник Сыктывкарского университета.\\
            Серия 1: Математика. Механика. Информатика. \theyear.\\Выпуск \thenumb~(\thesubnumb)\\}
            {\small\it\noindent Bulletin of Syktyvkar  University.\\
            Series 1: Mathematics. Mechanics. Informatics.}{\small\theyear;\thenumb(\thesubnumb)}
            }
           \vskip1.5mm
           \begin{center}\therubric\hfill\thearticletype\end{center}
           \vskip1.5mm
           {\noindent УДК~\theudk\\
           \noindent https://doi.org/\thedoi}
           \begin{center}
             {\sc\thetitle}
             \large{\ifgrant\footnote{\thegrant}\fi}
           \end{center}
           {\noindent\textbf\theauthor\\}
           {\noindent\theorganization}
           \markboth{\theruscontauth}
                    {\ifcolontit\thecolontit\else\therusconttit\fi}
           \thispagestyle{empty}}

\def\endpaper{\par\nobreak\medskip\small{\it\noindent
              \iforganization\theorganization
              \else{ }\fi
              \hfill Поступила~\thedate}}

