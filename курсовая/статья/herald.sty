\def\thesection{\arabic{section}}
\def\thesubsection{\thesection.\arabic{subsection}}
\def\initsect{\addtocounter{section}{1}\setcounter{subsection}{0}}
\def\rusordsection#1{\def\@currentlabel{\thesection}\vskip 2ex plus 1ex\goodbreak%
  \initsect\begin{center}\large\bf\S\thesection.\hskip .5em #1\end{center}}
\def\spsection#1#2{\vskip 2ex plus 1ex\goodbreak%
  \indent {\bf #2}\par}
\def\russection{\@ifnextchar*{\spsection}{\rusordsection}}


\def\ordsection#1{\def\@currentlabel{\thesection}\vskip 2ex plus 1ex\goodbreak%
  \initsect{\large\bf\thesection.\hskip .5em #1}\par}
\def\section{\@ifnextchar*{\spsection}{\ordsection}}

\def\subsection#1{\def\@currentlabel{\thesubsection}\vskip .8ex plus .5ex%
  \ifnum\c@subsection=0\par\else\goodbreak\fi\addtocounter{subsection}{1}%
  \normalsize\bf\thesubsection.\hskip .4em #1\rm\hskip .6em}
\def\theequation{\arabic{equation}}

\def\@biblabel#1{#1.}

